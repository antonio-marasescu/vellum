    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "22.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-storybook": "^10.5.7",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.1",
