    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "latest",
