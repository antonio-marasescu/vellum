{
  "name": "vellum",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/build-styles.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:stories": "vitest run --project=storybook",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "ng lint",
    "lint:styles": "stylelint \"projects/**/*.css\"",
    "format": "prettier --write \"**/*.{ts,html,css,json,md,mdx,mjs,js}\" \"!dist/**\" \"!node_modules/**\" \"!storybook-static/**\"",
    "format:check": "prettier --check \"**/*.{ts,html,css,json,md,mdx,mjs,js}\" \"!dist/**\" \"!node_modules/**\" \"!storybook-static/**\"",
    "storybook": "ng run vellum-lib:storybook",
    "build-storybook": "ng run vellum-lib:build-storybook",
    "verify:package": "publint dist/vellum-lib"
  },
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@angular/cdk": "~22.1.1",
    "@angular/common": "~22.1.1",
    "@angular/compiler": "~22.1.1",
    "@angular/core": "~22.1.1",
    "@angular/forms": "~22.1.1",
    "@angular/platform-browser": "~22.1.1",
    "rxjs": "~7.8.0",
    "tslib": "~2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.6.4",
    "@angular-devkit/architect": "~0.2201.3",
    "@angular-devkit/build-angular": "~22.1.3",
    "@angular-devkit/core": "~22.1.3",
    "@angular-eslint/builder": "22.1.0",
    "@angular/animations": "~22.1.1",
    "@angular/build": "~22.1.3",
    "@angular/cli": "~22.1.3",
    "@angular/compiler-cli": "~22.1.1",
    "@eslint/js": "~10.0.1",
    "@storybook/addon-a11y": "~10.5.7",
    "@storybook/addon-docs": "~10.5.7",
    "@storybook/addon-vitest": "~10.5.7",
    "@storybook/angular-vite": "~10.5.7",
    "@tailwindcss/postcss": "~4.3.3",
    "@tailwindcss/vite": "~4.3.3",
    "@types/node": "~20.19.43",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "22.1.0",
    "cssnano": "~8.0.4",
    "eslint": "~10.3.0",
    "eslint-plugin-storybook": "~10.5.7",
    "jsdom": "~28.0.0",
    "ng-packagr": "~22.1.1",
    "playwright": "~1.62.1",
    "postcss": "~8.5.26",
    "prettier": "~3.8.1",
    "prettier-plugin-tailwindcss": "~0.6.11",
    "publint": "^0.3.23",
    "storybook": "~10.5.7",
    "stylelint": "~16.15.0",
    "stylelint-config-standard": "~37.0.0",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "~8.2.1",
    "vitest": "4.1.10"
  }
}
